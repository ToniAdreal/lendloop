# ─────────────────────────────────────────────────────────────────────────────
# LendLoop environment variables. Copy to `.env.local` (app) and, where noted,
# to the Convex deployment / n8n environment. NEVER commit real secrets.
# The dummy values below are well-formed placeholders so `npm run build` passes
# before you plug in your own accounts.
# ─────────────────────────────────────────────────────────────────────────────

# --- Clerk (https://dashboard.clerk.com) -------------------------------------
# Publishable key format: pk_test_... (dev) / pk_live_... (prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZHVtbXktaW5zdGFuY2UuY2xlcmsuYWNjb3VudHMuZGV2JA
CLERK_SECRET_KEY=sk_test_dummy_secret_key_for_review_only
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard
# Issuer domain of your Clerk instance, used by Convex to validate Clerk JWTs.
# Looks like: https://your-instance.clerk.accounts.dev
CLERK_JWT_ISSUER_DOMAIN=https://dummy-instance.clerk.accounts.dev

# --- Convex (https://dashboard.convex.dev) -----------------------------------
# Deployment URL of the Convex backend (ends in .convex.cloud)
NEXT_PUBLIC_CONVEX_URL=https://dummy-deployment-000.convex.cloud
# The "site" URL serves Convex HTTP actions (used by n8n). It is the same host
# with .convex.site instead of .convex.cloud.
CONVEX_SITE_URL=https://dummy-deployment-000.convex.site
CONVEX_DEPLOYMENT=dev:dummy-deployment-000

# --- n8n automation -----------------------------------------------------------
# Public URL of the n8n "request-notification" webhook (production URL, not the
# /webhook-test/ URL). Read by the Convex action that fires borrow events.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/request-events
# Shared secrets (generate your own, e.g. `openssl rand -hex 32`):
# 1) Signs Convex -> n8n webhook payloads (HMAC-SHA256, header x-lendloop-signature)
N8N_WEBHOOK_SECRET=replace-with-a-long-random-string
# 2) Authenticates n8n -> Convex HTTP endpoints (HMAC over timestamp+method+path
#    for GET, timestamp+body for POST write-back)
LENDLOOP_SHARED_SECRET=replace-with-a-different-long-random-string

# --- n8n self-hosting (docker-compose) ---------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=UTC
